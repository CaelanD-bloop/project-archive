                errors -= 1
                print("\nNot a number.")
                if errors == 0:
                    print("\nToo many mistakes. Timeout for 60 seconds.")
                    time.sleep(60)
                    return
                continue

            guess = int(guess)
            tries += 1

            if guess == number:
                clear()
                print(f"\nTook you {tries} try(s).")
                time.sleep(2)
                return
            else:
                print("\nWrong, baby.")


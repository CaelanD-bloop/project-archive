import time
import random
import os
# -------------------------UTILITIES-------------------------------------------
def clear():
    os.system('cls' if os.name == 'nt' else 'clear')

def get_int(prompt):
    try:
        return int(prompt)
    except ValueError:
        return None

def lockdown():
    filename = '__lockdown.time'
    max_sleep = 1200 # 20 miniutes
    base_delay = 10
    
    if os.path.exists(filename):
            with open(filename, 'r+') as file:
                try:
                    tries = int(file.read().strip() or 0)
                except ValueError:
                    tries = 0 # fall back if file is corrupted
                
                tries += 1
                file.seek(0)
                file.write(str(tries))
                file.truncate()
        
    else:
        tries = 1
        with open(filename, 'w') as file:
            file.write(str(tries))
    
    # locktime grows with number of tries, but caps at max_sleep
    sleep = min(tries * base_delay, max_sleep)
    print(f"Lockdown active for {sleep} seconds.")
    time.sleep(sleep)
    print("Completed")
    
    # Delete file to reset the lockdown after it exceeds max_sleep with is 20 miniutes
    if sleep >= max_sleep:
        os.remove(filename)
        
    return
        


        clear()
        print('--------------------------------------------------------------')
        print("\nBabyMode — only for REAL babies.")
        print('\n--------------------------------------------------------------')
        number = random.randint(1, 5)
        tries = 0
        errors = 3

        while True:
            guess = input("\nGuess the number (1-5): ").strip()
            
            if guess.lower().strip() == '/s':

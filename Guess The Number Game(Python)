# --------------------------------DIFfICULTIES--------------------------------------------
def easy(hints = False):
    while True:
        result = game(1, 10, 3, hints, 'Easy')
        if result == 'again':
            continue
        break

def medium(hints = False):
    while True:
        result = game(1, 50, 4, hints, 'Medium')
        if result == 'again':
            continue
        break

def hard(hints = False):
    while True:
        result = game(1, 100, 4, hints, 'Hard')
        if result == 'again':
            continue
        break


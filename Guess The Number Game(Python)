# -----------------------------------MAIN GAME-------------------------------
def game(min_n, max_n, lives, hints = False, name = ''):
    clear()
    spam = 0
    if hints:
        print("Hints: ON")
    tries = 0
    
    x = random.randint(min_n, max_n)
    print('--------------------------------------------------------------')
    print(f"Dificulty = {name}")
    print(f"Lives = {lives}")
    print('--------------------------------------------------------------')

    while True:
        if spam == 5:
            print('\n--------------------------WARNING-----------------------------')
            print("\nNo spamming random things that aren't numbers")
            print("Do it again and be punished.")
            print('\n--------------------------------------------------------------')
        if spam == 6:
            clear()
            print("\nFine")
            print('\n--------------------------------------------------------------')
            lockdown()
            print('--------------------------------------------------------------')
        if spam > 6:
            print('\n--------------------------------------------------------------')
            lockdown()
            print('\n--------------------------------------------------------------')
            
        guess = input(f"\nGuess a number({min_n}-{max_n}): ")
        tries += 1
        
        if guess.lower() == '/s':
            print("\nThanks for playing!")
            return
            
        if guess.lower() == '/h':
            if hints:
                spam += 1
                if spam >= 3:
                    print("\nHint's deactivated.")
                    hints = False
                    continue
                print("\nHints Already Active!")
            elif spam < 3:
                print("\nHints Activated!")
                hints = True
                continue
            continue
        
        guess = get_int(guess)
        if guess == None:
            print("\nThat was not a number")
            spam += 1
            continue
        
        if guess == x:
            clear()
            print('************************************************************')
            print("\nYou got it!")
            print(f'It took you {tries} attempt(s)')
            print(f"\nThe number was {x}")
            print('\n************************************************************')
            time.sleep(3)
            return
        elif guess != x and hints != True:
            print("\nThat was not the number")
            lives -= 1
            if lives > 0:
                print(f"You have {lives} attempts(s)")
        if hints:
            if guess > x and lives > 1:
                print("\nYour guess is Greater than the Number")
            elif guess < x and lives > 1:
                print("\nYour guess is Less than the Number")
            lives -= 1
            if lives > 0:
                print(f"{lives} more attempt(s)")
        
        if lives == 0:
            time.sleep(1)
            clear()
            print('--------------------------------------------------------------')
            print("\nYou ran out of lives")
            if input('\nTry again(Yes/No): ').lower() == 'yes':
               return "again"
            else:
                print("\nWomp Womp")
                print('--------------------------------------------------------------')
                time.sleep(1.5)
                break

